<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Controller.Views.MeetingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Controller.Models">

    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Meeting Info Header -->
        <Border Background="White" CornerRadius="10" Padding="20,12">
            <StackPanel Orientation="Horizontal" Spacing="40" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Meeting ID" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{x:Bind ViewModel.MeetingId, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                               IsTextSelectionEnabled="True"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Port" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{x:Bind ViewModel.Port, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                               IsTextSelectionEnabled="True"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Participants" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{x:Bind ViewModel.Participants, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="You are" FontSize="12" Opacity="0.6"/>
                    <TextBlock Text="{x:Bind ViewModel.Role, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Video Host + Participants Sidebar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Video Area -->
            <Border Background="White" CornerRadius="10" Padding="20">
                <ContentControl x:Name="VideoHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Border>

            <!-- Right: Participants Sidebar -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE716;" FontSize="16"/>
                        <TextBlock Text="Participants" FontSize="16" FontWeight="SemiBold"/>
                        <Border Background="#EEF3F9" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{x:Bind ViewModel.Participants, Mode=OneWay}" 
                                       FontSize="12" FontWeight="SemiBold" Foreground="#0F5FC2"/>
                        </Border>
                    </StackPanel>

                    <!-- Participant List -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.ParticipantList}"
                              SelectionMode="None"
                              Padding="0,0,4,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ParticipantInfo">
                                <Border Background="#F6F8FB" 
                                        BorderBrush="#E1E4E8" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,4,0,4">
                                    <Grid ColumnSpacing="12" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Avatar -->
                                        <PersonPicture Grid.RowSpan="2" 
                                                       DisplayName="{x:Bind Username}" 
                                                       Width="36" Height="36" 
                                                       VerticalAlignment="Center"/>

                                        <!-- Username -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                                   Text="{x:Bind Username}" 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Role Badge -->
                                        <Border Grid.Row="0" Grid.Column="2" 
                                                Background="#EEF3F9" 
                                                CornerRadius="4" 
                                                Padding="6,2" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind RoleDisplay}" 
                                                       FontSize="11" 
                                                       Foreground="#0F5FC2" 
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Full Email -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{x:Bind Email}" 
                                                   FontSize="12" 
                                                   Opacity="0.65" 
                                                   TextWrapping="Wrap" 
                                                   IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>