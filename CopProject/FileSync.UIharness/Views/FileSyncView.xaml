<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileSync.UIharness.Views.FileSyncView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#202020" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header and Peer Connection Section -->
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock
                Text="File Synchronization (P2P)"
                FontSize="24"
                FontWeight="Bold"
                Foreground="White" />

            <!-- Connection Configuration Grid -->
            <Grid ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Labels -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="My Port" FontSize="12" Foreground="#AAAAAA" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Peer IP Address" FontSize="12" Foreground="#AAAAAA" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Peer Port" FontSize="12" Foreground="#AAAAAA" />

                <!-- Row 1: Input Controls -->
                <TextBox x:Name="MyPortTextBox" Grid.Row="1" Grid.Column="0" Text="8001" />
                <TextBox x:Name="PeerIpTextBox" Grid.Row="1" Grid.Column="1" Text="127.0.0.1" PlaceholderText="e.g. 192.168.1.50" />
                <TextBox x:Name="PeerPortTextBox" Grid.Row="1" Grid.Column="2" Text="8002" />

                <Button
                    x:Name="SyncButton"
                    Grid.Row="1"
                    Grid.Column="3"
                    Content="Sync Files"
                    HorizontalAlignment="Stretch"
                    Click="OnSyncButtonClick" />
            </Grid>

            <!-- Quick Presets -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Presets:" FontSize="12" Foreground="#777777" VerticalAlignment="Center" />
                <Button Content="Node A (8001 -> 8002)" FontSize="11" Padding="6,2" Click="OnPresetAClick" />
                <Button Content="Node B (8002 -> 8001)" FontSize="11" Padding="6,2" Click="OnPresetBClick" />
            </StackPanel>

            <TextBlock
                x:Name="StatusTextBlock"
                Text="Ready to synchronise over network"
                FontSize="13"
                Foreground="LightGreen"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Action Buttons and Folder info -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh Files" Click="OnRefreshClick" />
            <TextBlock
                x:Name="RootFolderTextBlock"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#888888" />
        </StackPanel>

        <!-- File List Table -->
        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column Headers -->
            <Grid Grid.Row="0" Padding="8,4" ColumnSpacing="12" Background="#2D2D2D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Foreground="#DDDDDD" />
                <TextBlock Grid.Column="1" Text="Size" FontWeight="SemiBold" Foreground="#DDDDDD" />
                <TextBlock Grid.Column="2" Text="Last Modified" FontWeight="SemiBold" Foreground="#DDDDDD" />
            </Grid>

            <!-- Files ListView -->
            <ListView
                x:Name="FilesListView"
                Grid.Row="1"
                BorderThickness="1"
                BorderBrush="#3D3D3D">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding RelativePath}" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="#AAAAAA" />
                            <TextBlock Grid.Column="2" Text="{Binding LastModifiedText}" Foreground="#888888" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
