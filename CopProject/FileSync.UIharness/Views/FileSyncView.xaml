<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileSync.UIharness.Views.FileSyncView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#202020" Padding="30">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Width="420">

            <TextBlock
                Text="File Synchronization"
                FontSize="28"
                FontWeight="Bold"
                Foreground="White"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="Select Peer to Synchronise:"
                FontSize="14"
                Foreground="#CCCCCC" />

            <ComboBox
                x:Name="PeerSelector"
                HorizontalAlignment="Stretch"
                PlaceholderText="Select peer or enter address...">
                <ComboBoxItem Content="Peer 1 (127.0.0.1:8001)" IsSelected="True" />
                <ComboBoxItem Content="Peer 2 (127.0.0.1:8002)" />
                <ComboBoxItem Content="Broadcast to All Peers" />
            </ComboBox>

            <Button
                x:Name="SyncButton"
                Content="Sync Files"
                HorizontalAlignment="Stretch"
                Click="OnSyncButtonClick" />

            <TextBlock
                x:Name="StatusTextBlock"
                Text="Ready to synchronise"
                FontSize="14"
                Foreground="LightGreen"
                HorizontalAlignment="Center"
                TextWrapping="Wrap" />

        </StackPanel>
    </Grid>
</UserControl>
