<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whiteboard\Whiteboard.csproj" />
    <ProjectReference Include="..\Insights\Insights.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Deploy WinAppSDK native runtime DLLs and metadata for in-process XAML UI-thread tests. -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.winui\2.3.9\runtimes-framework\win-x64\native\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\2.3.12\runtimes-framework\win-x64\native\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences\2.1.9\runtimes-framework\win-x64\native\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.dwrite\2.1.0\runtimes-framework\win-x64\native\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.ai\2.5.5\runtimes-framework\win-x64\native\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.search\2.5.5\runtimes-framework\win-x64\native\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.widgets\2.0.5\runtimes-framework\win-x64\native\**\*.*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.winui\2.3.9\metadata\Microsoft.*.winmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.foundation\2.3.12\metadata\Microsoft.*.winmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences\2.1.9\metadata\10.0.17763.0\Microsoft.*.winmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.ai\2.5.5\metadata\Microsoft.*.winmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.search\2.5.5\metadata\Microsoft.*.winmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk.widgets\2.0.5\metadata\Microsoft.*.winmd" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WinAppSdkFragment</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)microsoft.windowsappsdk.winui/2.3.9/runtimes-framework/package.appxfragment</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WinAppSdkFragment</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)microsoft.windowsappsdk.foundation/2.3.12/runtimes-framework/package.appxfragment</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WinAppSdkFragment</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)microsoft.windowsappsdk.interactiveexperiences/2.1.9/runtimes-framework/package.appxfragment</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WinAppSdkFragment</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)microsoft.windowsappsdk.ai/2.5.5/runtimes-framework/package.appxfragment</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WinAppSdkFragment</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)microsoft.windowsappsdk.search/2.5.5/runtimes-framework/package.appxfragment</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WinAppSdkFragment</_Parameter1>
      <_Parameter2>$(NuGetPackageRoot)microsoft.windowsappsdk.widgets/2.0.5/runtimes-framework/package.appxfragment</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>