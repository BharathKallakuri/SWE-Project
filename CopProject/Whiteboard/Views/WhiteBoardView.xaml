<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Name="foo"
    x:Class="Whiteboard.Views.WhiteBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <Grid Background="#F3F4F6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border
            Grid.Row="0"
            Background="White"
            Padding="12"
            BorderBrush="#DDDDDD"
            BorderThickness="0,0,0,1">

            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">

                    <Button
                        x:Name="ButtonPen"
                        ToolTipService.ToolTip="Pen"
                        Click="ButtonPen_Click">
                        <FontIcon Glyph="&#xF67B;"/>
                    </Button>

                    <Button
                        x:Name="ButtonUndo"
                        ToolTipService.ToolTip="Undo your last action"
                        IsEnabled="False"
                        Click="ButtonUndo_Click">
                        <FontIcon Glyph="&#xE7A7;"/>
                    </Button>

                    <Button
                        x:Name="ButtonRedo"
                        ToolTipService.ToolTip="Redo your last action"
                        IsEnabled="False"
                        Click="ButtonRedo_Click">
                        <FontIcon Glyph="&#xE7A6;"/>
                    </Button>

                    <Button
                        x:Name="ButtonSelectItems"
                        ToolTipService.ToolTip="Select items">
                        <FontIcon Glyph="&#xE8B0;"/>
                    </Button>

                    <Button
                        x:Name="ButtonEraseItems"
                        ToolTipService.ToolTip="Erase items"
                        Click="ButtonEraseItems_Click">
                        <FontIcon Glyph="&#xE75C;"/>
                    </Button>

                    <Button
                        x:Name="ButtonTextBox"
                        ToolTipService.ToolTip="Textbox">
                        <FontIcon Glyph="&#xE8AC;"/>
                    </Button>

                    <Button
                        x:Name="ButtonSquare"
                        ToolTipService.ToolTip="Square"
                        Click="ButtonSquare_Click">
                        <FontIcon Glyph="&#xE739;" />
                    </Button>

                    <Button
                        x:Name="ButtonCircle"
                        ToolTipService.ToolTip="Circle"
                        Click="ButtonCircle_Click">
                        <Ellipse
                            Width="18"
                            Height="18"
                            Fill="Transparent"
                            Stroke="Black"
                            StrokeThickness="2" />
                    </Button>

                    <Button
                        x:Name="ButtonDeleteSelectedItems"
                        ToolTipService.ToolTip="Delete selected items">
                        <FontIcon Glyph="&#xE74D;"/>
                    </Button>

                    <Button
                        x:Name="ButtonDeleteAllOwnedItems"
                        ToolTipService.ToolTip="Delete all owned items">
                        <FontIcon Glyph="&#xED62;"/>
                    </Button>

                    <Button
                        x:Name="ButtonUploadToCloud"
                        ToolTipService.ToolTip="Upload to cloud">
                        <FontIcon Glyph="&#xE898;" />
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- WHITEBOARD -->
        <Grid
            Grid.Row="1">
            <Border
                Background="White"
                BorderThickness="1"
                SizeChanged="CanvasContainer_SizeChanged">

                <Canvas
                    x:Name="WhiteboardCanvas"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerPressed="WhiteboardCanvas_PointerPressed"
                    PointerMoved="WhiteboardCanvas_PointerMoved"
                    PointerReleased="WhiteboardCanvas_PointerReleased"
                    PointerCaptureLost="WhiteboardCanvas_PointerCaptureLost"/>
            </Border>
        </Grid>
        <!-- STATUS BAR -->
        <Border
            Grid.Row="2"
            Background="White"
            Padding="12,0"
            BorderBrush="#DDDDDD"
            BorderThickness="0,1,0,0">

            <StackPanel
                Orientation="Horizontal"
                Spacing="24">

                <TextBlock
                    Text="Tool: Select"
                    Foreground="#333333"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Text="Color: Black"
                    Foreground="#333333"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Text="Zoom: 100%"
                    Foreground="#333333"
                    VerticalAlignment="Center"/>

            </StackPanel>
        </Border>

    </Grid>

</UserControl>