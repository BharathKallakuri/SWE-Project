<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UI.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:UI.Views"
    Title="Chat UI Demo">

    <Grid Background="#0D1016">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Simulated meeting area -->
        <Grid Grid.Column="0" Background="#171B23">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <FontIcon
                    Glyph="&#xE714;"
                    FontSize="48"
                    Foreground="#536176"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Meeting Preview"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#E4EAF2"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="This area represents the main meeting application."
                    FontSize="13"
                    Foreground="#8995A7"
                    TextWrapping="Wrap"
                    MaxWidth="320"
                    TextAlignment="Center"/>

                <TextBlock
                    x:Name="ServerAddressText"
                    FontSize="11"
                    Foreground="#71839A"
                    TextWrapping="Wrap"
                    MaxWidth="360"
                    TextAlignment="Center"/>

                <Button
                    x:Name="OpenParticipantButton"
                    Content="＋ Open another participant"
                    Click="OpenParticipant_Click"
                    Margin="0,14,0,0"
                    Padding="16,10"
                    Background="#3979C3"
                    Foreground="White"
                    BorderThickness="0"
                    HorizontalAlignment="Center"/>

            </StackPanel>

            <!-- Simulated meeting controls -->
            <Border
                VerticalAlignment="Bottom"
                Background="#202530"
                Padding="16">

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="18">

                    <FontIcon
                        Glyph="&#xE720;"
                        FontSize="20"
                        Foreground="#CFD7E3"/>

                    <FontIcon
                        Glyph="&#xE8D6;"
                        FontSize="20"
                        Foreground="#CFD7E3"/>

                    <FontIcon
                        Glyph="&#xE8F4;"
                        FontSize="20"
                        Foreground="#CFD7E3"/>

                </StackPanel>
            </Border>

        </Grid>

        <!-- Actual reusable chat component -->
        <chat:ChatPanel
            x:Name="ChatPanelControl"
            Grid.Column="1"/>

    </Grid>

</Window>

