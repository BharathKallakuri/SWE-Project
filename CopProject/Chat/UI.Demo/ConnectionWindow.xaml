<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UI.Demo.ConnectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chat UI Demo Connection">

    <Grid Background="#0D1016" Padding="32">
        <StackPanel Width="420" Spacing="14">
            <TextBlock
                Text="Chat UI Demo"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="#E4EAF2"/>

            <TextBlock
                Text="Host a meeting on this computer or connect to a friend's host."
                Foreground="#AAB6C7"
                TextWrapping="Wrap"/>

            <TextBlock Text="Username" Foreground="#E4EAF2"/>
            <TextBox x:Name="UsernameTextBox" PlaceholderText="Officer 1"/>

            <TextBlock Text="Bind IP (host)" Foreground="#E4EAF2"/>
            <TextBox x:Name="BindAddressTextBox" Text="0.0.0.0"/>

            <TextBlock Text="Host IP (client)" Foreground="#E4EAF2"/>
            <TextBox x:Name="HostAddressTextBox" PlaceholderText="192.168.1.10"/>

            <TextBlock Text="TCP port" Foreground="#E4EAF2"/>
            <TextBox x:Name="PortTextBox" Text="5000"/>

            <TextBlock
                x:Name="ErrorText"
                Foreground="#F28B82"
                TextWrapping="Wrap"
                Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                <Button
                    Content="Host meeting"
                    Click="Host_Click"
                    Padding="16,10"/>
                <Button
                    Content="Join meeting"
                    Click="Join_Click"
                    Padding="16,10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
