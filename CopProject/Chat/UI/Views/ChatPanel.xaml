<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UI.Views.ChatPanel"
    x:Name="ChatPanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,0,0,14" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Top" Visibility="{Binding LeftAvatarVisibility}">
                    <Ellipse Fill="{Binding AvatarBrush}"/>
                    <TextBlock Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="{Binding BubbleAlignment}">
                    <Grid ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SenderName}" FontSize="12" FontWeight="SemiBold" Foreground="#0B2A4A" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding EditedLabel}" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding TimestampText}" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="{Binding ReplyPreviewText}" Command="{Binding JumpToReplyCommand}" Visibility="{Binding ReplyPreviewVisibility}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" FontSize="10"
                        Background="#EEF3F9" Foreground="#0F5FC2" BorderBrush="#C9D3DF" BorderThickness="1"/>

                    <Border Background="{Binding BubbleBrush}" BorderBrush="{Binding MessageBorderBrush}" BorderThickness="{Binding MessageBorderThickness}"
                            CornerRadius="12" Padding="11,9" MaxWidth="430" Opacity="{Binding MessageOpacity}">
                        <TextBlock Text="{Binding DisplayContent}" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                   Foreground="{Binding ContentForeground}" FontStyle="{Binding ContentFontStyle}"/>
                    </Border>

                    <TextBlock Text="{Binding MentionLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"
                               Visibility="{Binding MentionVisibility}"/>

                    <ItemsControl ItemsSource="{Binding Reactions}" Width="260" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ToggleCommand}" ToolTipService.ToolTip="{Binding Tooltip}"
                                        Padding="0" MinWidth="0" Margin="0,0,5,4" Background="Transparent" BorderThickness="0">
                                    <Border Background="#F1F5F9" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="12" Padding="7,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding Emoji}" FontSize="12"/>
                                            <TextBlock Text="{Binding Count}" FontSize="11" Foreground="#1F2937"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Content="Reply" Command="{Binding ReplyInChatCommand}" Visibility="{Binding ReplyInChatVisibility}"
                                    Padding="7,3" MinWidth="0" FontSize="11" Background="Transparent" Foreground="#0F5FC2" BorderThickness="0"/>
                            <Button Content="Thread" Command="{Binding OpenThreadCommand}" Visibility="{Binding OpenThreadVisibility}"
                                    Padding="7,3" MinWidth="0" FontSize="11" Background="Transparent" Foreground="#0F5FC2" BorderThickness="0"/>
                            <Button Content="React" Loaded="MessageFlyoutButton_Loaded" Visibility="{Binding ReactionActionVisibility}"
                                    Padding="7,3" MinWidth="0" FontSize="11" Background="Transparent" Foreground="#0F5FC2" BorderThickness="0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="👍  Like" Command="{Binding ToggleReactionCommand}" CommandParameter="👍"/>
                                        <MenuFlyoutItem Text="❤️  Love" Command="{Binding ToggleReactionCommand}" CommandParameter="❤️"/>
                                        <MenuFlyoutItem Text="😂  Laugh" Command="{Binding ToggleReactionCommand}" CommandParameter="😂"/>
                                        <MenuFlyoutItem Text="😮  Surprised" Command="{Binding ToggleReactionCommand}" CommandParameter="😮"/>
                                        <MenuFlyoutItem Text="😢  Sad" Command="{Binding ToggleReactionCommand}" CommandParameter="😢"/>
                                        <MenuFlyoutItem Text="🎉  Celebrate" Command="{Binding ToggleReactionCommand}" CommandParameter="🎉"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="👏  Applause" Command="{Binding ToggleReactionCommand}" CommandParameter="👏"/>
                                        <MenuFlyoutItem Text="🔥  Fire" Command="{Binding ToggleReactionCommand}" CommandParameter="🔥"/>
                                        <MenuFlyoutItem Text="🚀  Rocket" Command="{Binding ToggleReactionCommand}" CommandParameter="🚀"/>
                                        <MenuFlyoutItem Text="🙌  Hands up" Command="{Binding ToggleReactionCommand}" CommandParameter="🙌"/>
                                        <MenuFlyoutItem Text="💯  100" Command="{Binding ToggleReactionCommand}" CommandParameter="💯"/>
                                        <MenuFlyoutItem Text="👀  Eyes" Command="{Binding ToggleReactionCommand}" CommandParameter="👀"/>
                                        <MenuFlyoutItem Text="🤔  Thinking" Command="{Binding ToggleReactionCommand}" CommandParameter="🤔"/>
                                        <MenuFlyoutItem Text="😍  Heart eyes" Command="{Binding ToggleReactionCommand}" CommandParameter="😍"/>
                                        <MenuFlyoutItem Text="✅  Check" Command="{Binding ToggleReactionCommand}" CommandParameter="✅"/>
                                        <MenuFlyoutItem Text="🙏  Thanks" Command="{Binding ToggleReactionCommand}" CommandParameter="🙏"/>
                                        <MenuFlyoutItem Text="🥳  Party" Command="{Binding ToggleReactionCommand}" CommandParameter="🥳"/>
                                        <MenuFlyoutItem Text="🫡  Salute" Command="{Binding ToggleReactionCommand}" CommandParameter="🫡"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="More" Loaded="MessageFlyoutButton_Loaded" Visibility="{Binding MoreActionsVisibility}"
                                    Padding="7,3" MinWidth="0" FontSize="11" Background="Transparent" Foreground="#0F5FC2" BorderThickness="0">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Edit message" Command="{Binding EditCommand}"/>
                                        <MenuFlyoutItem Text="Delete message" Command="{Binding DeleteCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="{Binding ReplyCountLabel}" Command="{Binding OpenThreadCommand}" Visibility="{Binding ReplyCountVisibility}"
                            HorizontalAlignment="Left" Padding="2,1" MinWidth="0" FontSize="11" Background="Transparent"
                            Foreground="#0F5FC2" BorderThickness="0"/>
                </StackPanel>

                <Grid Grid.Column="2" Width="32" Height="32" VerticalAlignment="Top" Visibility="{Binding RightAvatarVisibility}">
                    <Ellipse Fill="{Binding AvatarBrush}"/>
                    <TextBlock Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" Foreground="White" FontSize="10"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ParticipantTemplate">
            <Border Padding="8,7">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32">
                        <Ellipse Fill="{Binding AvatarBrush}"/>
                        <TextBlock Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" Foreground="White" FontSize="10"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="#1F2937"/>
                        <TextBlock Text="{Binding ParticipantRoleLabel}" FontSize="10" Foreground="#0F5FC2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MentionTargetTemplate">
            <Button Command="{Binding ToggleCommand}" HorizontalContentAlignment="Stretch" Padding="9,7" Background="Transparent" BorderThickness="0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="#1F2937"/>
                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#6B7280"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SelectionMark}" FontSize="16" Foreground="#0F5FC2" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Border BorderBrush="#E1E7EF" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="15,12" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Meeting chat" FontSize="18" FontWeight="SemiBold" Foreground="#0B2A4A"/>
                            <TextBlock Text="Messages are shared with everyone" FontSize="11" Foreground="#6B7280"/>
                        </StackPanel>
                        <Button x:Name="ParticipantsButton" Grid.Column="1" Padding="10,7" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center" AutomationProperties.Name="Show meeting participants">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE716;" FontSize="17" Foreground="#5F6B7A"/>
                                <TextBlock Text="{Binding ParticipantCount}" FontSize="12" Foreground="#1F4A78" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Border Background="#FFFFFF" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="10" Padding="10" Width="280" MaxHeight="430">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Participants" FontSize="15" FontWeight="SemiBold" Foreground="#0B2A4A"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ParticipantCountLabel}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ListView ItemsSource="{Binding Participants}" ItemTemplate="{StaticResource ParticipantTemplate}" SelectionMode="None"
                                                      MaxHeight="360" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid Visibility="{Binding ConversationVisibility}">
                        <ListView x:Name="MessagesList" Loaded="MessagesList_Loaded" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}"
                                  SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" BorderThickness="0" Padding="12,14,12,8"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <TextBlock Text="No messages yet. Start the conversation." Visibility="{Binding EmptyConversationVisibility}"
                                   Foreground="#6B7280" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="230"/>
                    </Grid>

                    <Grid Visibility="{Binding ThreadPanelVisibility}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="11,9" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Content="‹" Command="{Binding CloseThreadCommand}" FontSize="22" Padding="5,0" MinWidth="28" Background="Transparent" Foreground="#0F5FC2" BorderThickness="0"/>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ThreadHeaderText}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    <TextBlock Text="Replies in this conversation" FontSize="10" Foreground="#6B7280"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="×" Command="{Binding CloseThreadCommand}" FontSize="18" Padding="5,0" MinWidth="28" Background="Transparent" Foreground="#5F6B7A" BorderThickness="0"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Margin="12,10" Padding="10" CornerRadius="10" Background="#F5F7FA" BorderBrush="#D9E2EC" BorderThickness="1">
                            <StackPanel Spacing="5">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ActiveThreadRoot.SenderName}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActiveThreadRoot.TimestampText}" FontSize="10" Foreground="#6B7280"/>
                                </Grid>
                                <TextBlock Text="{Binding ActiveThreadRoot.DisplayContent}" TextWrapping="Wrap" FontSize="12" Foreground="#1F2937"/>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="ThreadMessagesList" Grid.Row="2" Loaded="ThreadMessagesList_Loaded" ItemsSource="{Binding ThreadMessages}"
                                  ItemTemplate="{StaticResource MessageTemplate}" SelectionMode="None" Background="Transparent" BorderThickness="0"
                                  Padding="12,8,12,8" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="#F5F7FA" BorderBrush="#E1E7EF" BorderThickness="0,1,0,0" Padding="11,9,11,11">
                    <StackPanel Spacing="7">
                        <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding StatusVisibility}" FontSize="10" TextWrapping="Wrap" Foreground="#B45309"/>

                        <StackPanel Visibility="{Binding MainComposerVisibility}" Spacing="7">
                            <Border Visibility="{Binding ReplyBannerVisibility}" Background="#EEF3F9" BorderBrush="#C9D3DF" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ReplyingToText}" FontSize="11" Foreground="#0F5FC2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="×" Command="{Binding CancelChatReplyCommand}" Padding="4,0" MinWidth="24" Background="Transparent" Foreground="#5F6B7A" BorderThickness="0"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding SelectedMentions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E8F1FF" BorderBrush="#B6D3F5" BorderThickness="1" CornerRadius="12" Padding="7,3" Margin="0,0,5,3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="#0F5FC2"/>
                                                <Button Content="×" Command="{Binding RemoveCommand}" FontSize="10" Padding="0" MinWidth="14" Background="Transparent" Foreground="#1F4A78" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="MentionButton" Content="＋" FontSize="18" Padding="9,4" MinWidth="36" Background="#EEF3F9" Foreground="#0F5FC2" BorderBrush="#C9D3DF" BorderThickness="1" ToolTipService.ToolTip="Mention a participant, ChAI, or @all">
                                    <Button.Flyout>
                                        <Flyout Placement="Top">
                                            <Border Background="#FFFFFF" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="10" Padding="10" Width="270">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Mention someone" FontSize="13" FontWeight="SemiBold" Foreground="#0B2A4A"/>
                                                    <TextBox Text="{Binding MentionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search participants, ChAI, or @all"/>
                                                    <ListView ItemsSource="{Binding MentionSearchResults}" ItemTemplate="{StaticResource MentionTargetTemplate}" MaxHeight="230"
                                                              SelectionMode="None" Background="Transparent" BorderThickness="0"/>
                                                    <TextBlock Text="Select more than one person when needed." FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBox x:Name="MessageInput" Grid.Column="1" Text="{Binding MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Message everyone..." AcceptsReturn="False" TextWrapping="Wrap" MaxLength="4000" MinHeight="42" MaxHeight="86"
                                         Padding="11,9" Background="#FFFFFF" Foreground="#0B2A4A" BorderBrush="#C9D3DF" BorderThickness="1" KeyDown="MessageInput_KeyDown"/>
                                <Button Grid.Column="2" Content="Send" Command="{Binding SendMessageCommand}" Padding="13,8" Margin="2,0,0,0"
                                        Background="#0F5FC2" Foreground="White" BorderThickness="0" VerticalAlignment="Bottom"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ThreadComposerVisibility}" Spacing="7">
                            <TextBlock Text="Reply in thread" FontSize="10" Foreground="#0F5FC2"/>
                            <ItemsControl ItemsSource="{Binding SelectedMentions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#E8F1FF" BorderBrush="#B6D3F5" BorderThickness="1" CornerRadius="12" Padding="7,3" Margin="0,0,5,3">
                                            <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="#0F5FC2"/><Button Content="×" Command="{Binding RemoveCommand}" FontSize="10" Padding="0" MinWidth="14" Background="Transparent" Foreground="#1F4A78" BorderThickness="0"/></StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="ThreadMentionButton" Content="＋" FontSize="18" Padding="9,4" MinWidth="36" Background="#EEF3F9" Foreground="#0F5FC2" BorderBrush="#C9D3DF" BorderThickness="1" ToolTipService.ToolTip="Mention a participant, ChAI, or @all">
                                    <Button.Flyout>
                                        <Flyout Placement="Top">
                                            <Border Background="#FFFFFF" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="10" Padding="10" Width="270">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Mention someone" FontSize="13" FontWeight="SemiBold" Foreground="#0B2A4A"/>
                                                    <TextBox Text="{Binding MentionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search participants, ChAI, or @all"/>
                                                    <ListView ItemsSource="{Binding MentionSearchResults}" ItemTemplate="{StaticResource MentionTargetTemplate}" MaxHeight="230" SelectionMode="None" Background="Transparent" BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBox x:Name="ThreadMessageInput" Grid.Column="1" Text="{Binding ThreadMessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Write a reply..." AcceptsReturn="False" TextWrapping="Wrap" MaxLength="4000" MinHeight="42" MaxHeight="86"
                                         Padding="11,9" Background="#FFFFFF" Foreground="#0B2A4A" BorderBrush="#C9D3DF" BorderThickness="1" KeyDown="ThreadMessageInput_KeyDown"/>
                                <Button Grid.Column="2" Content="Reply" Command="{Binding SendThreadReplyCommand}" Padding="12,8" Background="#0F5FC2" Foreground="White" BorderThickness="0" VerticalAlignment="Bottom"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding EditComposerVisibility}" Spacing="7">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Editing message" FontSize="11" Foreground="#B45309" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelEditCommand}" Padding="8,3" Background="Transparent" Foreground="#5F6B7A" BorderThickness="0"/>
                            </Grid>
                            <TextBox Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="Wrap" MaxLength="4000"
                                     MinHeight="42" MaxHeight="86" Padding="11,9" Background="#FFFFFF" Foreground="#0B2A4A" BorderBrush="#C9D3DF" BorderThickness="1"/>
                            <Button Content="Save changes" Command="{Binding SaveEditCommand}" HorizontalAlignment="Right" Padding="12,7" Background="#0F5FC2" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <TextBox x:Name="NativeEmojiInput" Width="1" Height="1" Opacity="0" IsTabStop="False"
                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 TextChanged="NativeEmojiInput_TextChanged" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
