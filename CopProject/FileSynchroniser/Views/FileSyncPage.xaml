<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FileSynchroniser.Views.FileSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FileSynchroniser.Views"
    xmlns:vm="using:FileSynchroniser.ViewModels"
    xmlns:utils="using:Utils"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="File Synchroniser" FontSize="24" />

        <!-- Root directory -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="Synchronised folder:" />
            <TextBlock Text="{x:Bind ViewModel.RootDirectory}"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Peer Connection Controls -->
        <StackPanel Grid.Row="2" Spacing="8">
            <!-- Automatic Peer Selection from Meeting / Controller -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Available Peers:" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox x:Name="PeersComboBox"
                          ItemsSource="{x:Bind ViewModel.AvailablePeers}"
                          SelectedItem="{x:Bind ViewModel.SelectedPeer, Mode=TwoWay}"
                          SelectionChanged="OnPeerSelectionChanged"
                          MinWidth="260"
                          PlaceholderText="Select peer to sync...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="utils:ControllerUser">
                            <TextBlock Text="{x:Bind ToString()}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Refresh Peers" Click="OnRefreshPeersClick" />
            </StackPanel>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="My Port" FontSize="11" Foreground="Gray" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Peer IP Address" FontSize="11" Foreground="Gray" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Peer Port" FontSize="11" Foreground="Gray" />

                <TextBox x:Name="MyPortTextBox" Grid.Row="1" Grid.Column="0" Text="8001" />
                <TextBox x:Name="PeerIpTextBox" Grid.Row="1" Grid.Column="1" Text="127.0.0.1" PlaceholderText="e.g. 192.168.1.50" />
                <TextBox x:Name="PeerPortTextBox" Grid.Row="1" Grid.Column="2" Text="8002" />

                <Button
                    x:Name="SyncButton"
                    Grid.Row="1"
                    Grid.Column="3"
                    Content="Sync Files"
                    HorizontalAlignment="Stretch"
                    Click="OnSyncButtonClick" />
            </Grid>

            <!-- Buttons: Add File, Refresh, Delete, and Presets -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add File" Click="AddFile_Click" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="Delete Selected" Command="{x:Bind ViewModel.DeleteSelectedCommand}" />
                <Button Content="Node A (8001 -> 8002)" FontSize="11" Click="OnPresetAClick" />
                <Button Content="Node B (8002 -> 8001)" FontSize="11" Click="OnPresetBClick" />
            </StackPanel>
        </StackPanel>

        <!-- Error banner (only open when the ViewModel reports an error) -->
        <InfoBar Grid.Row="3"
                 Severity="Error"
                 Title="Error"
                 IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- File list -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Grid Grid.Row="0" Padding="12,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Size" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Last Modified" FontWeight="SemiBold" />
            </Grid>

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.Files}"
                      SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}"
                      SelectionMode="Single"
                      BorderThickness="1"
                      BorderBrush="Gray">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SyncFileItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind LastModifiedText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Status bar -->
        <TextBlock x:Name="StatusTextBlock" Grid.Row="5" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
    </Grid>
</Page>