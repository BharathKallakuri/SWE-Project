<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UX.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="White" Width="400" Padding="30" CornerRadius="10"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
            <TextBlock Text="Welcome" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>

            <PersonPicture Width="72" Height="72"/>
            <HyperlinkButton Content="Add profile picture" HorizontalAlignment="Center"
                             ToolTipService.ToolTip="Coming soon"/>

            <TextBox Header="User ID" PlaceholderText="e.g. aashritha"
                     Text="{x:Bind ViewModel.UserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{x:Bind ViewModel.UserIdError, Mode=OneWay}" Foreground="Red" FontSize="12"
                       TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasUserIdError, Mode=OneWay}"/>

            <TextBox Header="Email (@smail.iitpkd.ac.in)"
                     Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="Email_KeyDown" LostFocus="Email_LostFocus"/>
            <TextBlock Text="{x:Bind ViewModel.EmailError, Mode=OneWay}" Foreground="Red" FontSize="12"
                       TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasEmailError, Mode=OneWay}"/>

            <Button Content="CONTINUE" Command="{x:Bind ViewModel.SignInCommand}" Background="#0F5FC2"
                    Foreground="White" HorizontalAlignment="Stretch" Height="40"/>
        </StackPanel>
    </Border>
</UserControl>
