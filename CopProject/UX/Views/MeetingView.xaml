<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UX.Views.MeetingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="MeetingRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="16">

            <Grid RowSpacing="12" Visibility="{x:Bind ViewModel.IsHomeSelected, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" CornerRadius="10" Padding="20,12">
                    <StackPanel Orientation="Horizontal" Spacing="40" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Meeting ID" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{x:Bind ViewModel.MeetingId, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                       IsTextSelectionEnabled="True"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Port" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{x:Bind ViewModel.Port, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                                       IsTextSelectionEnabled="True"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Participants" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{x:Bind ViewModel.Participants, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="You are" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{x:Bind ViewModel.Role, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
                    <!-- VIDEO TEAM: your module's View is put here (IMeetingModule with Slot = Video) -->
                    <ContentControl x:Name="VideoHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"/>
                </Border>
            </Grid>

            <Border Background="White" CornerRadius="10" Padding="20"
                    Visibility="{x:Bind ViewModel.IsShareSelected, Mode=OneWay}">
                <!-- SCREEN SHARING TEAM: your module's View is put here (Slot = Share) -->
                <ContentControl x:Name="ShareHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="20"
                    Visibility="{x:Bind ViewModel.IsWhiteboardSelected, Mode=OneWay}">
                <!-- WHITEBOARD TEAM: your module's View is put here (Slot = Whiteboard) -->
                <ContentControl x:Name="BoardHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Spacing="8" Margin="0,0,0,16">
            <ToggleButton Content="Home" Width="100" Height="50"
                          IsChecked="{x:Bind ViewModel.IsHomeSelected, Mode=OneWay}"
                          Command="{x:Bind ViewModel.ShowHomeCommand}"/>
            <ToggleButton Content="Share" Width="100" Height="50"
                          IsChecked="{x:Bind ViewModel.IsShareSelected, Mode=OneWay}"
                          Command="{x:Bind ViewModel.ShowShareCommand}"/>
            <ToggleButton Content="Whiteboard" Width="100" Height="50"
                          IsChecked="{x:Bind ViewModel.IsWhiteboardSelected, Mode=OneWay}"
                          Command="{x:Bind ViewModel.ShowWhiteboardCommand}"/>
            <ToggleButton Content="Chat" Width="100" Height="50"
                          IsChecked="{x:Bind ViewModel.IsChatOpen, Mode=TwoWay}"/>
            <Button Content="Incidents" Width="100" Height="50"
                    Command="{x:Bind ViewModel.IncidentsCommand}"/>
            <Button Content="{x:Bind ViewModel.EndButtonText, Mode=OneWay}" Width="130" Height="50"
                    Click="End_Click"
                    Background="#D13438" Foreground="White"/>
        </StackPanel>

        <Border Grid.Column="1" Grid.RowSpan="2"
                Width="320"
                Visibility="{x:Bind ViewModel.IsChatOpen, Mode=OneWay}"
                Background="White" CornerRadius="10" Margin="0,16,16,16" Padding="16">
            <!-- CHAT TEAM: your module's View is put here (Slot = Chat) -->
            <ContentControl x:Name="ChatHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
