<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="UX.Views.JoinDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Join meeting">
    <StackPanel Spacing="12">
        <TextBox Header="Meeting ID" PlaceholderText="e.g. 123-456-789"
                 Text="{x:Bind ViewModel.MeetingId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox Header="Port" PlaceholderText="e.g. 5000"
                 Text="{x:Bind ViewModel.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="Red" TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="JoinButton" Content="Join" Style="{StaticResource AccentButtonStyle}" Click="Join_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
