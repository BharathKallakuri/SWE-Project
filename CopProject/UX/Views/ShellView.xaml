<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UX.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:UX.Views">

    <Grid RequestedTheme="Light" Background="#EEF3F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="#0B2A4A" Padding="20,10">
            <TextBlock Text="SecureMeet" FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>

            <TextBlock Text="{x:Bind ViewModel.MeetingTitle, Mode=OneWay}" Foreground="White" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.IsMeetingVisible, Mode=OneWay}"/>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                        Visibility="{x:Bind ViewModel.IsUserPanelVisible, Mode=OneWay}">
                <Button Click="Profile_Click" Padding="4,2" Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Edit your profile">
                    <TextBlock Text="{x:Bind ViewModel.ProfileName, Mode=OneWay}" Foreground="White"/>
                </Button>
                <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" Foreground="White"/>
            </StackPanel>
        </Grid>

        <views:LoginView x:Name="LoginPane" Grid.Row="1"
                         Visibility="{x:Bind ViewModel.IsLoginVisible, Mode=OneWay}"/>
        <views:DashboardView x:Name="DashboardPane" Grid.Row="1"
                             Visibility="{x:Bind ViewModel.IsDashboardVisible, Mode=OneWay}"/>
        <views:IncidentsView x:Name="IncidentsPane" Grid.Row="1"
                             Visibility="{x:Bind ViewModel.IsIncidentsVisible, Mode=OneWay}"/>
        <views:MeetingView x:Name="MeetingPane" Grid.Row="1"
                           Visibility="{x:Bind ViewModel.IsMeetingVisible, Mode=OneWay}"/>
    </Grid>
</UserControl>
