<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="UX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UX"
    xmlns:controller="using:Controller.Views"
    xmlns:chat="using:UI.Views"
    xmlns:screenshare="using:ScreenShare.Views">

    <Grid x:Name="Root" RequestedTheme="Light" Background="#EEF3F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="#0B2A4A" Padding="20,10">
            <TextBlock Text="SecureMeet" FontSize="20" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center"/>

            <StackPanel x:Name="UserPanel" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Right" Visibility="Collapsed">

                <TextBlock x:Name="MeetingInfoText" Foreground="White" FontSize="12"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
               <Button x:Name="IncidentsTopBtn" Content="Incidents" Click="Incidents_Click"
       Foreground="White" Background="#1F4A78"/>
               <Button x:Name="LocationTopBtn" Content="Location" Click="Location_Click"
       Foreground="White" Background="#1F4A78"/>
               <Button x:Name="CloudTopBtn" Content="Cloud" Click="Cloud_Click"
       Foreground="White" Background="#1F4A78"/>
                <Button x:Name="CrashHandlerTopBtn" Content="CrashHandler" Click="CrashHandler_Click"
       Foreground="White" Background="#1F4A78"/>
                <PersonPicture x:Name="ProfilePic" Width="30" Height="30"/>
                <TextBlock x:Name="ProfileName" Foreground="White" VerticalAlignment="Center"/>
                <Button Content="Edit profile" Click="EditProfile_Click" Foreground="White"
                        Background="#1F4A78"/>
                <Button Content="Sign out" Click="SignOut_Click" Foreground="White"
                        Background="#1F4A78"/>
            </StackPanel>
        </Grid>

        <!-- Login screen -->
        <Grid x:Name="LoginView" Grid.Row="1">
            <Border Background="White" Width="400" Padding="30" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="Welcome" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoginError" Foreground="Red" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <Button x:Name="SignInBtn" Content="Sign in with Google" Click="SignIn_Click"
                            Background="#0F5FC2" Foreground="White"
                            HorizontalAlignment="Stretch" Height="40"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dashboard screen -->
        <Grid x:Name="DashView" Grid.Row="1" Padding="40,24" RowSpacing="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="GreetingText" FontSize="32" FontWeight="SemiBold"/>

            <Grid Grid.Row="1" ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Content="Start Meeting" Click="Start_Click" Height="100"
                        Background="#0F5FC2" Foreground="White"
                        FontSize="20" HorizontalAlignment="Stretch"/>
                <Button Grid.Column="1" Content="Join with ID" Click="Join_Click"
                        Height="100" FontSize="20" Background="White"
                        HorizontalAlignment="Stretch"/>
            </Grid>

            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Previous Meeting Records" FontSize="18" FontWeight="SemiBold"/>
                    <ListView x:Name="RecordsList" Grid.Row="1" SelectionMode="None"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Incidents page -->
        <Grid x:Name="IncidentsView" Grid.Row="1" Padding="40,24" RowSpacing="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Back" Click="IncidentsBack_Click" Background="White"/>
                <TextBlock Text="Incidents" FontSize="32" FontWeight="SemiBold"/>
            </StackPanel>

            <Frame x:Name="IncidentsFrame" Grid.Row="1"/>
        </Grid>

        <!-- Location page -->
        <Grid x:Name="LocationView" Grid.Row="1" Padding="16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Back" Click="LocationBack_Click" Background="White"/>
                <TextBlock Text="Location" FontSize="32" FontWeight="SemiBold"/>
            </StackPanel>
            <ContentControl x:Name="LocationHost" Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>

        <!-- Cloud page -->
        <Grid x:Name="CloudView" Grid.Row="1" Padding="40,24" RowSpacing="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Back" Click="CloudBack_Click" Background="White"/>
                <TextBlock Text="Cloud" FontSize="32" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
                <Grid>
                    <!-- CLOUD TEAM: WRITE YOUR XAML CODE INSIDE THIS GRID -->
                </Grid>
            </Border>
        </Grid>

        <!-- CrashHandler page -->
        <Grid x:Name="CrashHandlerView" Grid.Row="1" Padding="40,24" RowSpacing="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Back" Click="CrashHandlerBack_Click" Background="White"/>
                <TextBlock Text="CrashHandler" FontSize="32" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20">
                <Grid>
                    <!-- CrashHandler TEAM: WRITE YOUR XAML CODE INSIDE THIS GRID -->
                </Grid>
            </Border>
        </Grid>

        <!-- Meeting screen -->
        <Grid x:Name="MeetingView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="16">
                <!-- CONTROLLER TEAM: Host our MeetingView here -->
                <Border x:Name="HomePanel" Background="White" CornerRadius="10">
                    <controller:MeetingView x:Name="ControllerMeetingView"/>
                </Border>

                <Border x:Name="SharePanel" Background="White" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel Padding="20">
                        <!-- SCREEN SHARING TEAM: add your UI here -->
                        <screenshare:ScreenShareGridView x:Name="ScreenShareView"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BoardPanel" Background="White" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel Padding="20">
                        <!-- WHITEBOARD TEAM: add your UI here -->
                        <TextBlock Text="Whiteboard module goes here"/>
                    </StackPanel>
                </Border>

                <!-- FILE SYNC TEAM: Hosting FileSync inside meeting workspace -->
                <Border x:Name="FileSyncView" Background="White" CornerRadius="10" Visibility="Collapsed" Padding="20">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="File Synchroniser" FontSize="24" FontWeight="SemiBold"/>
                        <Frame x:Name="FileSyncFrame" Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        Spacing="8" Margin="0,0,0,16">
                <ToggleButton x:Name="HomeBtn" Content="Home" Click="HomeBtn_Click"
                              Width="90" Height="50" IsChecked="True"/>
                <ToggleButton x:Name="ShareBtn" Content="Share" Click="ShareBtn_Click"
                              Width="90" Height="50"/>
                <ToggleButton x:Name="BoardBtn" Content="Whiteboard" Click="BoardBtn_Click"
                              Width="100" Height="50"/>
                <ToggleButton x:Name="ChatBtn" Content="Chat" Click="ChatBtn_Click"
                              Width="90" Height="50"/>
                <!-- FILE SYNC TEAM: Toggle button inside meeting controls -->
                <ToggleButton x:Name="FileSyncBtn" Content="FileSync" Click="FileSyncBtn_Click"
                              Width="90" Height="50"/>
                <Button Content="Incidents" Click="Incidents_Click" Width="90" Height="50"/>
                <Button Content="Location" Click="Location_Click" Width="90" Height="50"/>
                <Button x:Name="EndBtn" Content="End Meeting" Click="End_Click" Width="110" Height="50"
                        Background="#D13438" Foreground="White"/>
            </StackPanel>

            <Border x:Name="ChatPanel" Grid.Column="1" Grid.RowSpan="2" Width="320"
                    Background="White" CornerRadius="10" Margin="0,16,16,16"
                    Visibility="Collapsed">
                <chat:ChatPanel x:Name="MeetingChatPanel"/>
            </Border>
            <local:ResizeHandle x:Name="ChatResizer" Grid.Column="1" Grid.RowSpan="2" Width="10"
                                HorizontalAlignment="Left" Margin="0,16,0,16"
                                Background="Transparent" Visibility="Collapsed"
                                PointerPressed="ChatResizer_PointerPressed"
                                PointerMoved="ChatResizer_PointerMoved"
                                PointerReleased="ChatResizer_PointerReleased">
                <Border Width="4" Height="40" CornerRadius="2" Background="#B0B8C4"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </local:ResizeHandle>
        </Grid>
    </Grid>
</Window>
