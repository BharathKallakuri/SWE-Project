<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>

      <!-- Visual Studio (Microsoft Code Coverage) -->
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*\\filesynchroniser\.dll$</ModulePath>
                <ModulePath>.*\\chat\.dll$</ModulePath>
                <ModulePath>.*\\ui\.dll$</ModulePath>
                <ModulePath>.*\\networking\.dll$</ModulePath>
                <ModulePath>.*\\cloud\.dll$</ModulePath>
                <ModulePath>.*\\cloud\.crash\.ui\.dll$</ModulePath>
                <ModulePath>.*\\incident\.dll$</ModulePath>
                <ModulePath>.*\\location\.dll$</ModulePath>
                <ModulePath>.*\\whiteboard\.dll$</ModulePath>
                <ModulePath>.*\\cloud\.networking\.server\.dll$</ModulePath>
                <ModulePath>.*\\cloud\.ui\.dll$</ModulePath>
                <ModulePath>.*\\controller\.dll$</ModulePath>
                <ModulePath>.*\\screenshare\.dll$</ModulePath>
                <ModulePath>.*\\insights\.dll$</ModulePath>
                <ModulePath>.*\\diagnosis\.ui\.dll$</ModulePath>
                <ModulePath>.*\\ux\.(dll|exe)$</ModulePath>
              </Include>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*\\obj\\.*</Source>
                <Source>.*\.g\.cs$</Source>
                <Source>.*\.g\.i\.cs$</Source>
                <Source>.*\.razor\.g\.cs$</Source>
                <Source>.*\.razor\.g\.i\.cs$</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>

    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
