<ContentDialog
    x:Class="Incidents.Views.CorrelateIncidentsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Correlate Incidents"
    PrimaryButtonText="Correlate"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12">
        <TextBlock
            Text="Select the incidents you want to correlate with this incident."
            TextWrapping="Wrap" />

        <ListView
            ItemsSource="{Binding AvailableIncidents}"
            SelectionMode="None"
            MaxHeight="350">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            Grid.Column="0"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Text="{Binding Id}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>