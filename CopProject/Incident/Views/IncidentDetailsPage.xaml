<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Incident_module.Views.IncidentDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Incident_module.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Actions Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Content="Back"
                Click="BackButton_Click"
                VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding Incident.Title}"
                    FontSize="24"
                    FontWeight="Bold"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Text="{Binding Incident.Id}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <!-- Toggle Edit Button -->
                <Button
                    Content="{Binding EditButtonText}"
                    Command="{Binding ToggleEditModeCommand}"
                    Visibility="{Binding ReadOnlyVisibility}" />

                <!-- Save / Cancel Buttons when editing -->
                <Button
                    Content="Cancel"
                    Command="{Binding CancelEditCommand}"
                    Visibility="{Binding EditVisibility}" />

                <Button
                    Content="Save Changes"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding SaveChangesCommand}"
                    Visibility="{Binding EditVisibility}" />
            </StackPanel>
        </Grid>

        <!-- Error Banner -->
        <InfoBar
            Grid.Row="1"
            Title="Error"
            Message="{Binding ErrorMessage}"
            IsOpen="True"
            Severity="Error"
            Visibility="{Binding ErrorVisibility}" />

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Details & Edit Panel -->
                <StackPanel Grid.Column="0" Spacing="20">

                    <!-- General Info Card -->
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel Spacing="16">
                            <TextBlock Text="Incident Details" FontSize="18" FontWeight="SemiBold" />

                            <TextBox
                                Header="Description"
                                Text="{Binding Incident.Description}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                AcceptsReturn="True" />

                            <!-- Status, Category, Severity Grid -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Status -->
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Status" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock
                                        Text="{Binding Incident.Status}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Visibility="{Binding ReadOnlyVisibility}" />

                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding StatusOptions}"
                                        SelectedItem="{Binding EditableStatus, Mode=TwoWay}"
                                        Visibility="{Binding EditVisibility}" />
                                </StackPanel>

                                <!-- Category -->
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Category" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock
                                        Text="{Binding Incident.Category}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Visibility="{Binding ReadOnlyVisibility}" />

                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding CategoryOptions}"
                                        SelectedItem="{Binding EditableCategory, Mode=TwoWay}"
                                        Visibility="{Binding EditVisibility}" />
                                </StackPanel>

                                <!-- Severity -->
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Severity" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <TextBlock
                                        Text="{Binding Incident.Severity}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Visibility="{Binding ReadOnlyVisibility}" />

                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding SeverityOptions}"
                                        SelectedItem="{Binding EditableSeverity, Mode=TwoWay}"
                                        Visibility="{Binding EditVisibility}" />
                                </StackPanel>
                            </Grid>

                            <!-- Metadata -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Created By" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Incident.CreatedBy}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Creation Time" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Incident.CreationTime}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Last Updated" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Incident.UpdateTime}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Location Card -->
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel Spacing="16">
                            <TextBlock Text="Location Details" FontSize="18" FontWeight="SemiBold" />

                            <!-- Read-Only View -->
                            <StackPanel Spacing="8" Visibility="{Binding ReadOnlyVisibility}">
                                <TextBlock Text="{Binding Incident.Location.Address, TargetNullValue='No address specified'}" FontWeight="Medium" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12">
                                    <Run Text="Lat: " />
                                    <Run Text="{Binding Incident.Location.Latitude}" />
                                    <Run Text=" | Long: " />
                                    <Run Text="{Binding Incident.Location.Longitude}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Editable View -->
                            <StackPanel Spacing="12" Visibility="{Binding EditVisibility}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <NumberBox
                                        Grid.Column="0"
                                        Header="Latitude"
                                        Value="{Binding EditableLatitude, Mode=TwoWay}"
                                        SmallChange="0.0001"
                                        SpinButtonPlacementMode="Inline" />

                                    <NumberBox
                                        Grid.Column="1"
                                        Header="Longitude"
                                        Value="{Binding EditableLongitude, Mode=TwoWay}"
                                        SmallChange="0.0001"
                                        SpinButtonPlacementMode="Inline" />
                                </Grid>

                                <TextBox
                                    Header="Address / Landmark"
                                    Text="{Binding EditableAddress, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Evidence Card -->
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel Spacing="16">
                            <Grid>
                                <TextBlock Text="Evidence Attachments" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />

                                <Button
                                    HorizontalAlignment="Right"
                                    Content="Add Evidence"
                                    Click="AddEvidence_Click" />
                            </Grid>

                            <ListView ItemsSource="{Binding Evidences}" SelectionMode="None" MaxHeight="200">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding FilePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Right Column: Change History Timeline Card -->
                <Border
                    Grid.Column="1"
                    Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    VerticalAlignment="Top">

                    <StackPanel Spacing="16">
                        <TextBlock Text="Change Timeline" FontSize="18" FontWeight="SemiBold" />

                        <ListView ItemsSource="{Binding ChangeTimeline}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse
                                            Grid.Column="0"
                                            Width="8"
                                            Height="8"
                                            Margin="0,6,0,0"
                                            VerticalAlignment="Top"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13" />
                                            <TextBlock
                                                Text="{Binding ChangedTime}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>