<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>

      <!-- GitHub Actions (Coverlet) -->
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[FileSynchroniser]*,[Chat]*,[Networking]*,[Cloud]*,[Incident]*,[Location]*,[Whiteboard]*</Include>
          <ExcludeByAttribute>ExcludeFromCodeCoverage</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**,**/*.g.cs,**/*.g.i.cs,**/*.xaml.cs,**/*.razor</ExcludeByFile>
        </Configuration>
      </DataCollector>

    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
