<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <!-- GitHub Actions (Coverlet) -->
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[FileSynchroniser]*,[Chat]*,[UI]*,[Networking]*,[Cloud]*,[Cloud.Crash.UI]*,[Incident]*,[Location]*,[Whiteboard]*,[Cloud.Networking.Server]*,[Cloud.UI]*,[Insights]*,[Controller]*,[Screenshare]*,[Diagnosis.UI]*,[UX]*</Include>
          <ExcludeByAttribute>ExcludeFromCodeCoverage</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**,**/*.g.cs,**/*.g.i.cs,**/*.razor.g.cs,**/*.razor.g.i.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
