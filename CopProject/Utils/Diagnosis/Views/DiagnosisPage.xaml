<Page
    x:Class="Utils.Diagnosis.Views.DiagnosisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Diagnosis" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Send the recent app log to Insights for a summary and suggested remedies."
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button Content="Run diagnosis" Click="RunDiagnosis_Click"
                    IsEnabled="{Binding CanRun}"/>
            <ProgressRing Width="24" Height="24" IsActive="{Binding IsBusy}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
        </StackPanel>


        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16">
            <ScrollViewer>
                <TextBlock Text="{Binding Report}" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
