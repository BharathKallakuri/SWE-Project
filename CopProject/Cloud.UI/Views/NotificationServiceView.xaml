<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Cloud.UI.Views.NotificationServiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Cloud.UI.Models"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <!--allows us to write components tht can be embedded in aother UI-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- connection card -->
            <RowDefinition Height="Auto"/>   <!-- error -->
            <RowDefinition Height="Auto"/>   <!-- composer -->
            <RowDefinition Height="Auto"/>   <!-- list header -->
            <RowDefinition Height="*"/>      <!-- list -->
        </Grid.RowDefinitions>

        <!-- Connection card: title, status, server URL, connection buttons -->
        <Border Background="#F5F7FA" BorderBrush="#DCE4EE" BorderThickness="1"
                CornerRadius="10" Padding="20,16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Notification Service" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.StateHint, Mode=OneWay}"
                                   FontSize="13" Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{x:Bind GetStateBrush(ViewModel.State), Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- typed at runtime -->
                <TextBox Grid.Row="1" Header="Server URL" PlaceholderText="https://host:port/hub"
                         Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="ServerUrlBox_KeyDown"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ConnectCommand, Mode=OneWay}"
                            Background="#0F5FC2" Foreground="White" MinWidth="110">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71B;" FontSize="14"/>
                            <TextBlock Text="Connect"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.DisconnectCommand, Mode=OneWay}" MinWidth="110">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Disconnect"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ReconnectCommand, Mode=OneWay}" MinWidth="110">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Reconnect"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error (takes no space when there is none) -->
        <TextBlock Grid.Row="1" Margin="0,12,0,0" Foreground="#D13438" TextWrapping="Wrap"
                   Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"/>

        <!-- Composer -->
        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageBox"
                     PlaceholderText="Type a message to send to everyone…"
                     MinHeight="40" VerticalContentAlignment="Center"
                     Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="MessageBox_KeyDown"/>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.SendCommand, Mode=OneWay}"
                    Background="#0F5FC2" Foreground="White" MinHeight="40" MinWidth="130">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE724;" FontSize="14"/>
                    <TextBlock Text="Send to all"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- List header -->
        <Grid Grid.Row="3" Margin="0,20,0,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold"/>
                <Border Background="#E3ECF8" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Notifications.Count, Mode=OneWay}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#0F5FC2"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}"
                           VerticalAlignment="Center" Opacity="0.65" FontSize="12"/>
                <Button Command="{x:Bind ViewModel.SyncCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="13"/>
                        <TextBlock Text="Sync"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                        <TextBlock Text="Clear"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Notification list -->
        <Border Grid.Row="4" Background="#F5F7FA" BorderBrush="#DCE4EE" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                          SelectionMode="None" Padding="10">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationItem">
                            <Border Background="White" CornerRadius="8" Padding="14,12"
                                    BorderThickness="1" BorderBrush="#DCE4EE">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="38" Height="38" VerticalAlignment="Top"
                                                   DisplayName="{x:Bind SenderId}"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="15"/>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.6"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE715;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center"/>
                    <TextBlock Text="No notifications yet." FontSize="15" Opacity="0.6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
