<UserControl
    x:Class="LocationTracker.Views.LocationMapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#EDEDED" Padding="16"
                BorderBrush="#BDBDBD" BorderThickness="0,0,1,0">
            <StackPanel Spacing="14">
                <TextBlock Text="Map Filters" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" Foreground="Black"/>

                <TextBlock Text="Title contains" FontSize="14" FontWeight="SemiBold" Foreground="Black"/>
                <TextBox x:Name="TitleFilterBox"
                         Foreground="Black"
                         Text="{Binding TitleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Category" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="Black"/>
                <ComboBox x:Name="CategoryFilterBox"
                          Foreground="Black"
                          ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>

                <TextBlock Text="Severity" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="Black"/>
                <ComboBox x:Name="SeverityFilterBox"
                          Foreground="Black"
                          ItemsSource="{Binding SeverityOptions}"
                          SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"/>

                <TextBlock Text="Status" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="Black"/>
                <ComboBox x:Name="StatusFilterBox"
                          Foreground="Black"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>

                <TextBlock Text="From date" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="Black"/>
                <CalendarDatePicker x:Name="FromDatePicker"
                                    Foreground="Black"
                                    Date="{Binding FromDate, Mode=TwoWay}" />

                <TextBlock Text="To date" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="Black"/>
                <CalendarDatePicker x:Name="ToDatePicker"
                                    Foreground="Black"
                                    Date="{Binding ToDate, Mode=TwoWay}" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="DarkRed"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" MinHeight="500" MinWidth="600">
            <controls:WebView2 x:Name="MapView"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               DefaultBackgroundColor="White" />
        </Grid>
    </Grid>
</UserControl>
